<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="gameplay-ui-root">
        <ui:VisualElement name="gameplay-ui-hud-layer" class="gameplay-ui-layer" />
        <ui:VisualElement name="gameplay-ui-context-layer" class="gameplay-ui-layer" />
        <ui:VisualElement name="gameplay-ui-modal-layer" class="gameplay-ui-layer gameplay-ui-layer--modal" />
        <ui:VisualElement name="gameplay-ui-global-transition-layer" class="gameplay-ui-layer gameplay-ui-layer--global-transition" />
        <ui:VisualElement name="gameplay-ui-debug-layer" class="gameplay-ui-layer" />
    </ui:VisualElement>
</ui:UXML>
