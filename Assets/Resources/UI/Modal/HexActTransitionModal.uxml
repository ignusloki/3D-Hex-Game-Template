<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="act-transition-modal-root">
        <ui:VisualElement name="act-transition-modal-overlay" class="act-transition-overlay">
            <ui:VisualElement
                name="act-transition-intermission-shell"
                class="act-transition-page-shell act-transition-page-shell--narrow">
                <ui:Label name="act-transition-intermission-title" text="Act Complete" />

                <ui:VisualElement name="act-transition-intermission-illustration-frame">
                    <ui:VisualElement name="act-transition-intermission-illustration-inset">
                        <ui:Image name="act-transition-intermission-illustration-image" />
                        <ui:Label name="act-transition-intermission-illustration-placeholder" text="" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement name="act-transition-intermission-body-wrap">
                    <ui:Label
                        name="act-transition-intermission-body"
                        text="The caravan gathers itself for the road ahead." />
                </ui:VisualElement>

                <ui:VisualElement class="act-transition-divider" />

                <ui:VisualElement name="act-transition-intermission-resource-summary">
                    <ui:VisualElement class="act-transition-intermission-resource-column">
                        <ui:Label
                            name="act-transition-intermission-current-header"
                            class="act-transition-intermission-resource-header"
                            text="Current Resources" />
                        <ui:VisualElement class="act-transition-intermission-resource-rows">
                            <ui:VisualElement class="act-transition-intermission-resource-row">
                                <ui:Label
                                    class="act-transition-intermission-resource-label"
                                    text="Food" />
                                <ui:Label
                                    name="act-transition-intermission-current-food-value"
                                    class="act-transition-intermission-resource-value"
                                    text="0" />
                            </ui:VisualElement>
                            <ui:VisualElement class="act-transition-intermission-resource-row">
                                <ui:Label
                                    class="act-transition-intermission-resource-label"
                                    text="Morale" />
                                <ui:Label
                                    name="act-transition-intermission-current-morale-value"
                                    class="act-transition-intermission-resource-value"
                                    text="0" />
                            </ui:VisualElement>
                            <ui:VisualElement class="act-transition-intermission-resource-row">
                                <ui:Label
                                    class="act-transition-intermission-resource-label"
                                    text="Gold" />
                                <ui:Label
                                    name="act-transition-intermission-current-gold-value"
                                    class="act-transition-intermission-resource-value"
                                    text="0" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement name="act-transition-intermission-resource-divider" />

                    <ui:VisualElement class="act-transition-intermission-resource-column">
                        <ui:Label
                            name="act-transition-intermission-reward-header"
                            class="act-transition-intermission-resource-header"
                            text="Act Reward" />
                        <ui:VisualElement class="act-transition-intermission-resource-rows">
                            <ui:VisualElement class="act-transition-intermission-resource-row">
                                <ui:Label
                                    class="act-transition-intermission-resource-label"
                                    text="Food" />
                                <ui:Label
                                    name="act-transition-intermission-reward-food-value"
                                    class="act-transition-intermission-resource-value"
                                    text="+0" />
                            </ui:VisualElement>
                            <ui:VisualElement class="act-transition-intermission-resource-row">
                                <ui:Label
                                    class="act-transition-intermission-resource-label"
                                    text="Morale" />
                                <ui:Label
                                    name="act-transition-intermission-reward-morale-value"
                                    class="act-transition-intermission-resource-value"
                                    text="+0" />
                            </ui:VisualElement>
                            <ui:VisualElement class="act-transition-intermission-resource-row">
                                <ui:Label
                                    class="act-transition-intermission-resource-label"
                                    text="Gold" />
                                <ui:Label
                                    name="act-transition-intermission-reward-gold-value"
                                    class="act-transition-intermission-resource-value"
                                    text="+0" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="act-transition-actions act-transition-actions--center">
                    <ui:Button
                        name="act-transition-intermission-button"
                        class="act-transition-primary-button"
                        text="Choose a Boon" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement
                name="act-transition-selection-shell"
                class="act-transition-page-shell act-transition-page-shell--wide">
                <ui:VisualElement name="act-transition-selection-header">
                    <ui:VisualElement name="act-transition-selection-copy">
                        <ui:Label
                            name="act-transition-selection-prompt"
                            text="Choose one boon to carry into the next act." />
                        <ui:Label
                            name="act-transition-selection-note"
                            text="This choice determines the family for Act 3." />
                    </ui:VisualElement>

                    <ui:VisualElement name="act-transition-selection-resource-panel">
                        <ui:Label name="act-transition-selection-resource-label" text="Carry-over" />
                        <ui:VisualElement name="act-transition-selection-resource-strip" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement name="act-transition-selection-card-row" />

                <ui:VisualElement name="act-transition-selection-detail-panel">
                    <ui:Label name="act-transition-selection-detail-meta" text="Inspect" />
                    <ui:Label name="act-transition-selection-detail-title" text="Select a boon to inspect it." />
                    <ui:Label name="act-transition-selection-detail-keywords" text="Keywords appear here." />
                    <ui:Label name="act-transition-selection-detail-effect" text="Select a boon to inspect it." />
                    <ui:VisualElement name="act-transition-selection-detail-glossary" />
                    <ui:Label name="act-transition-selection-detail-flavor" text="" />
                    <ui:Label name="act-transition-selection-detail-note" text="" />
                </ui:VisualElement>

                <ui:VisualElement class="act-transition-actions act-transition-actions--center">
                    <ui:Button
                        name="act-transition-selection-button"
                        class="act-transition-primary-button"
                        text="Begin Act 2" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
