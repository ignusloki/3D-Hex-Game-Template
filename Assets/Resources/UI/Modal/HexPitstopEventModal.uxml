<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="pitstop-modal-root">
        <ui:VisualElement name="pitstop-modal-overlay">
            <ui:VisualElement name="pitstop-modal-shell">
                <ui:VisualElement name="pitstop-modal-header">
                    <ui:VisualElement name="pitstop-modal-topline">
                        <ui:VisualElement name="pitstop-modal-head-copy">
                            <ui:Label name="pitstop-modal-meta" text="MILL PITSTOP • 7,2" />
                            <ui:Label name="pitstop-modal-title" text="The Miller's Ledger" />
                            <ui:VisualElement name="pitstop-arrival-row">
                                <ui:Label name="pitstop-arrival-kicker" text="Arrival Bonus" />
                                <ui:VisualElement name="pitstop-arrival-chips" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <ui:VisualElement name="pitstop-modal-resource-strip" />
                    </ui:VisualElement>

                    <ui:Label
                        name="pitstop-modal-description"
                        text="The miller counts sacks by lantern light and offers a quiet bargain before the road calls the caravan onward." />
                </ui:VisualElement>

                <ui:VisualElement name="pitstop-options-section">
                    <ui:VisualElement name="pitstop-options-list" />
                </ui:VisualElement>

                <ui:VisualElement name="pitstop-resolution-section">
                    <ui:Label name="pitstop-resolution-kicker" text="Outcome" />
                    <ui:Label name="pitstop-resolution-choice" text="Buy two fresh sacks" />
                    <ui:VisualElement name="pitstop-resolution-chips" />
                    <ui:VisualElement name="pitstop-modal-actions">
                        <ui:Button name="pitstop-continue-button" text="Map" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
