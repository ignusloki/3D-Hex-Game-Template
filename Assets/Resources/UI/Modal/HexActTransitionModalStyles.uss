#act-transition-modal-root {
    flex-grow: 1;
    display: none;
}

#act-transition-modal-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: rgba(8, 10, 16, 0.58);
}

#act-transition-intermission-shell,
#act-transition-selection-shell {
    display: none;
}

.act-transition-page-shell {
    flex-direction: column;
    justify-content: flex-start;
    flex-shrink: 1;
    padding-left: 32px;
    padding-right: 32px;
    padding-top: 32px;
    padding-bottom: 32px;
    background-color: rgba(227, 220, 207, 0.99);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(185, 174, 153, 0.98);
    border-right-color: rgba(185, 174, 153, 0.98);
    border-top-color: rgba(185, 174, 153, 0.98);
    border-bottom-color: rgba(185, 174, 153, 0.98);
}

.act-transition-page-shell--narrow {
    width: 800px;
    max-width: 92%;
    min-height: 640px;
}

.act-transition-page-shell--wide {
    width: 1040px;
    max-width: 94%;
    min-height: 700px;
}

#act-transition-intermission-shell {
    width: 860px;
    max-width: 860px;
    min-height: 640px;
    padding-left: 40px;
    padding-right: 40px;
    padding-top: 36px;
    padding-bottom: 32px;
    align-items: center;
    background-color: rgba(231, 224, 210, 0.99);
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
    border-left-color: rgba(199, 188, 168, 1);
    border-right-color: rgba(199, 188, 168, 1);
    border-top-color: rgba(199, 188, 168, 1);
    border-bottom-color: rgba(199, 188, 168, 1);
}

#act-transition-intermission-title {
    color: rgba(36, 33, 27, 1);
    font-size: 48px;
    line-height: 50px;
    unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 24px;
}

#act-transition-intermission-body-wrap {
    width: 760px;
    align-items: center;
    flex-shrink: 0;
    margin-bottom: 20px;
}

#act-transition-intermission-body {
    max-width: 640px;
    color: rgba(77, 71, 61, 1);
    font-size: 18px;
    line-height: 24px;
    unity-text-align: middle-center;
    white-space: normal;
    flex-shrink: 0;
}

#act-transition-intermission-illustration-frame {
    width: 760px;
    max-width: 760px;
    height: 280px;
    flex-shrink: 0;
    background-color: rgba(207, 198, 181, 1);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(200, 188, 166, 1);
    border-right-color: rgba(200, 188, 166, 1);
    border-top-color: rgba(200, 188, 166, 1);
    border-bottom-color: rgba(200, 188, 166, 1);
    overflow: hidden;
    margin-bottom: 18px;
}

#act-transition-intermission-illustration-inset {
    flex-grow: 1;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    overflow: hidden;
}

#act-transition-intermission-illustration-image {
    width: 100%;
    height: 100%;
}

#act-transition-intermission-illustration-placeholder {
    display: none;
}

#act-transition-intermission-shell .act-transition-divider {
    width: 760px;
    height: 1px;
    flex-shrink: 0;
    margin-bottom: 20px;
    background-color: rgba(210, 199, 181, 1);
}

#act-transition-intermission-resource-summary {
    width: 760px;
    min-height: 116px;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 28px;
}

.act-transition-intermission-resource-column {
    flex-direction: column;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
}

.act-transition-intermission-resource-header {
    color: rgba(141, 116, 80, 1);
    font-size: 14px;
    line-height: 18px;
    -unity-font-style: bold;
    margin-bottom: 10px;
}

.act-transition-intermission-resource-rows {
    flex-direction: column;
    gap: 8px;
}

.act-transition-intermission-resource-row {
    height: 24px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.act-transition-intermission-resource-label {
    color: rgba(53, 49, 41, 1);
    font-size: 16px;
    line-height: 20px;
}

.act-transition-intermission-resource-value {
    color: rgba(36, 33, 27, 1);
    font-size: 18px;
    line-height: 20px;
    -unity-font-style: bold;
}

#act-transition-intermission-resource-divider {
    width: 1px;
    height: 92px;
    margin-left: 24px;
    margin-right: 24px;
    background-color: rgba(207, 195, 175, 1);
    flex-shrink: 0;
}

#act-transition-selection-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    gap: 24px;
    flex-shrink: 0;
}

#act-transition-selection-copy {
    flex-direction: column;
    flex-grow: 1;
    max-width: 620px;
    min-width: 0;
}

#act-transition-selection-prompt {
    color: rgba(42, 41, 37, 1);
    font-size: 32px;
    line-height: 36px;
    -unity-font-style: bold;
    white-space: normal;
}

#act-transition-selection-note {
    margin-top: 10px;
    color: rgba(91, 85, 74, 1);
    font-size: 16px;
    line-height: 22px;
    white-space: normal;
}

#act-transition-selection-resource-panel {
    width: auto;
    min-height: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    align-items: flex-end;
    flex-shrink: 0;
}

#act-transition-selection-resource-label {
    color: rgba(168, 137, 82, 0.95);
    font-size: 12px;
    -unity-font-style: bold;
    unity-text-align: middle-right;
    text-transform: uppercase;
    letter-spacing: 0.6px;
}

#act-transition-selection-resource-strip {
    margin-top: 10px;
    flex-direction: row;
    justify-content: flex-end;
    gap: 10px;
}

.act-transition-resource-mini {
    min-width: 90px;
    height: 30px;
    padding-left: 12px;
    padding-right: 12px;
    border-top-left-radius: 999px;
    border-top-right-radius: 999px;
    border-bottom-left-radius: 999px;
    border-bottom-right-radius: 999px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.act-transition-resource-mini-label {
    color: rgba(91, 85, 74, 1);
    font-size: 11px;
    -unity-font-style: bold;
    white-space: nowrap;
}

.act-transition-resource-mini-value {
    color: rgba(42, 41, 37, 1);
    font-size: 13px;
    -unity-font-style: bold;
    white-space: nowrap;
}

.act-transition-resource-mini--food {
    background-color: rgba(155, 124, 70, 0.14);
    border-left-color: rgba(155, 124, 70, 0.42);
    border-right-color: rgba(155, 124, 70, 0.42);
    border-top-color: rgba(155, 124, 70, 0.42);
    border-bottom-color: rgba(155, 124, 70, 0.42);
}

.act-transition-resource-mini--morale {
    background-color: rgba(133, 93, 100, 0.14);
    border-left-color: rgba(133, 93, 100, 0.38);
    border-right-color: rgba(133, 93, 100, 0.38);
    border-top-color: rgba(133, 93, 100, 0.38);
    border-bottom-color: rgba(133, 93, 100, 0.38);
}

.act-transition-resource-mini--gold {
    background-color: rgba(168, 137, 82, 0.16);
    border-left-color: rgba(168, 137, 82, 0.44);
    border-right-color: rgba(168, 137, 82, 0.44);
    border-top-color: rgba(168, 137, 82, 0.44);
    border-bottom-color: rgba(168, 137, 82, 0.44);
}

#act-transition-selection-card-row {
    margin-top: 24px;
    flex-direction: row;
    justify-content: center;
    align-items: stretch;
    gap: 16px;
    flex-shrink: 0;
}

.act-transition-card {
    width: 235px;
    min-height: 350px;
    flex-direction: column;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 16px;
    padding-bottom: 16px;
    background-color: rgba(239, 233, 223, 0.98);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(185, 174, 153, 1);
    border-right-color: rgba(185, 174, 153, 1);
    border-top-color: rgba(185, 174, 153, 1);
    border-bottom-color: rgba(185, 174, 153, 1);
}

.act-transition-card:focus {
    outline-width: 0;
}

.act-transition-card--hovered {
    background-color: rgba(245, 239, 231, 1);
    border-left-color: rgba(168, 137, 82, 0.74);
    border-right-color: rgba(168, 137, 82, 0.74);
    border-top-color: rgba(168, 137, 82, 0.74);
    border-bottom-color: rgba(168, 137, 82, 0.74);
}

.act-transition-card--selected {
    background-color: rgba(248, 243, 235, 1);
    border-left-color: rgba(155, 124, 70, 0.96);
    border-right-color: rgba(155, 124, 70, 0.96);
    border-top-color: rgba(155, 124, 70, 0.96);
    border-bottom-color: rgba(155, 124, 70, 0.96);
}

.act-transition-card--disabled {
    opacity: 0.56;
}

.act-transition-card-title {
    min-height: 54px;
    color: rgba(42, 41, 37, 1);
    font-size: 22px;
    line-height: 26px;
    -unity-font-style: bold;
    white-space: normal;
}

.act-transition-card-art-frame {
    margin-top: 12px;
    height: 148px;
    background-color: rgba(211, 202, 184, 0.48);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(185, 174, 153, 0.96);
    border-right-color: rgba(185, 174, 153, 0.96);
    border-top-color: rgba(185, 174, 153, 0.96);
    border-bottom-color: rgba(185, 174, 153, 0.96);
}

.act-transition-card--hovered .act-transition-card-art-frame,
.act-transition-card--selected .act-transition-card-art-frame {
    border-left-color: rgba(168, 137, 82, 0.7);
    border-right-color: rgba(168, 137, 82, 0.7);
    border-top-color: rgba(168, 137, 82, 0.7);
    border-bottom-color: rgba(168, 137, 82, 0.7);
}

.act-transition-card-art-inset {
    flex-grow: 1;
    margin-left: 8px;
    margin-right: 8px;
    margin-top: 8px;
    margin-bottom: 8px;
    background-color: rgba(225, 217, 204, 0.96);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    overflow: hidden;
    align-items: center;
    justify-content: center;
}

.act-transition-card-art-image {
    width: 100%;
    height: 100%;
}

.act-transition-card-art-placeholder {
    position: absolute;
    left: 10px;
    top: 10px;
    right: 10px;
    bottom: 10px;
    color: rgba(0, 0, 0, 0);
    unity-text-align: middle-center;
}

.act-transition-card-summary {
    margin-top: 14px;
    min-height: 36px;
    color: rgba(91, 85, 74, 1);
    font-size: 14px;
    line-height: 20px;
    flex-grow: 1;
    white-space: normal;
}

.act-transition-card-family {
    margin-top: 12px;
    min-height: 28px;
    align-self: flex-start;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 5px;
    padding-bottom: 5px;
    color: rgba(155, 124, 70, 1);
    font-size: 12px;
    -unity-font-style: bold;
    unity-text-align: middle-center;
    background-color: rgba(168, 137, 82, 0.1);
    border-top-left-radius: 999px;
    border-top-right-radius: 999px;
    border-bottom-left-radius: 999px;
    border-bottom-right-radius: 999px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(168, 137, 82, 0.38);
    border-right-color: rgba(168, 137, 82, 0.38);
    border-top-color: rgba(168, 137, 82, 0.38);
    border-bottom-color: rgba(168, 137, 82, 0.38);
}

#act-transition-selection-detail-panel {
    margin-top: 24px;
    min-height: 208px;
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 20px;
    padding-bottom: 20px;
    flex-direction: column;
    gap: 12px;
    background-color: rgba(235, 229, 219, 0.96);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(185, 174, 153, 0.96);
    border-right-color: rgba(185, 174, 153, 0.96);
    border-top-color: rgba(185, 174, 153, 0.96);
    border-bottom-color: rgba(185, 174, 153, 0.96);
    flex-shrink: 0;
}

#act-transition-selection-detail-meta {
    color: rgba(168, 137, 82, 0.95);
    font-size: 12px;
    -unity-font-style: bold;
    text-transform: uppercase;
    letter-spacing: 0.6px;
}

#act-transition-selection-detail-title {
    color: rgba(42, 41, 37, 1);
    font-size: 28px;
    line-height: 32px;
    -unity-font-style: bold;
    white-space: normal;
}

#act-transition-selection-detail-keywords {
    color: rgba(91, 85, 74, 1);
    font-size: 14px;
    line-height: 20px;
    -unity-font-style: bold;
    white-space: normal;
}

#act-transition-selection-detail-effect {
    color: rgba(47, 49, 46, 1);
    font-size: 16px;
    line-height: 22px;
    white-space: normal;
}

#act-transition-selection-detail-glossary {
    flex-direction: column;
    gap: 8px;
}

.act-transition-glossary-row {
    flex-direction: row;
    align-items: flex-start;
    gap: 12px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 10px;
    padding-bottom: 10px;
    background-color: rgba(227, 220, 207, 0.58);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(185, 174, 153, 0.92);
    border-right-color: rgba(185, 174, 153, 0.92);
    border-top-color: rgba(185, 174, 153, 0.92);
    border-bottom-color: rgba(185, 174, 153, 0.92);
}

.act-transition-glossary-term {
    min-width: 110px;
    color: rgba(42, 41, 37, 1);
    font-size: 14px;
    line-height: 18px;
    -unity-font-style: bold;
    white-space: normal;
}

.act-transition-glossary-text {
    flex-grow: 1;
    color: rgba(91, 85, 74, 1);
    font-size: 14px;
    line-height: 20px;
    white-space: normal;
}

#act-transition-selection-detail-flavor {
    color: rgba(100, 94, 83, 1);
    font-size: 13px;
    line-height: 19px;
    white-space: normal;
}

#act-transition-selection-detail-note {
    color: rgba(91, 85, 74, 1);
    font-size: 13px;
    line-height: 19px;
    white-space: normal;
}

.act-transition-actions {
    margin-top: 24px;
    flex-direction: row;
    flex-shrink: 0;
}

#act-transition-intermission-shell .act-transition-actions {
    margin-top: 0;
}

.act-transition-actions--center {
    justify-content: center;
    width: 100%;
}

.act-transition-primary-button {
    width: 170px;
    height: 44px;
    color: rgba(243, 239, 228, 1);
    background-color: rgba(42, 41, 37, 0.98);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(42, 41, 37, 1);
    border-right-color: rgba(42, 41, 37, 1);
    border-top-color: rgba(42, 41, 37, 1);
    border-bottom-color: rgba(42, 41, 37, 1);
    -unity-font-style: bold;
    font-size: 16px;
}

#act-transition-intermission-shell .act-transition-primary-button {
    width: 184px;
    height: 48px;
    color: rgba(244, 240, 232, 1);
    background-color: rgba(36, 33, 27, 1);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    font-size: 20px;
    line-height: 22px;
}

.act-transition-primary-button:hover {
    background-color: rgba(59, 58, 52, 1);
}

#act-transition-intermission-shell .act-transition-primary-button:hover {
    background-color: rgba(47, 43, 36, 1);
}

#act-transition-intermission-shell .act-transition-primary-button:active {
    background-color: rgba(29, 26, 22, 1);
}

.act-transition-primary-button:disabled {
    opacity: 0.56;
}
