#act-transition-modal-root {
    flex-grow: 1;
    display: none;
}

#act-transition-modal-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

#act-transition-modal-scrim {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(8, 10, 16, 0.58);
}

#act-transition-intermission-shell,
#act-transition-selection-shell {
    display: none;
}

.act-transition-page-shell {
    flex-direction: column;
    justify-content: flex-start;
    flex-shrink: 1;
    padding-left: 32px;
    padding-right: 32px;
    padding-top: 32px;
    padding-bottom: 32px;
    background-color: rgba(227, 220, 207, 0.99);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(185, 174, 153, 0.98);
    border-right-color: rgba(185, 174, 153, 0.98);
    border-top-color: rgba(185, 174, 153, 0.98);
    border-bottom-color: rgba(185, 174, 153, 0.98);
}

.act-transition-page-shell--narrow {
    width: 800px;
    max-width: 92%;
    min-height: 640px;
}

.act-transition-page-shell--wide {
    width: 1040px;
    max-width: 94%;
    min-height: 700px;
}

#act-transition-intermission-shell {
    width: 860px;
    max-width: 860px;
    min-height: 640px;
    padding-left: 40px;
    padding-right: 40px;
    padding-top: 36px;
    padding-bottom: 32px;
    align-items: center;
    background-color: rgba(231, 224, 210, 0.99);
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
    border-left-color: rgba(199, 188, 168, 1);
    border-right-color: rgba(199, 188, 168, 1);
    border-top-color: rgba(199, 188, 168, 1);
    border-bottom-color: rgba(199, 188, 168, 1);
}

#act-transition-selection-shell {
    width: 1360px;
    max-width: 1360px;
    height: 960px;
    min-height: 960px;
    padding-left: 28px;
    padding-right: 28px;
    padding-top: 28px;
    padding-bottom: 28px;
    align-items: stretch;
    justify-content: flex-start;
    background-color: rgba(233, 225, 211, 0.99);
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    border-bottom-left-radius: 16px;
    border-bottom-right-radius: 16px;
    border-left-color: rgba(199, 181, 146, 1);
    border-right-color: rgba(199, 181, 146, 1);
    border-top-color: rgba(199, 181, 146, 1);
    border-bottom-color: rgba(199, 181, 146, 1);
    overflow: hidden;
}

#act-transition-intermission-title {
    color: rgba(36, 33, 27, 1);
    font-size: 48px;
    line-height: 50px;
    unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 24px;
}

#act-transition-intermission-body-wrap {
    width: 760px;
    align-items: center;
    flex-shrink: 0;
    margin-bottom: 20px;
}

#act-transition-intermission-body {
    max-width: 640px;
    color: rgba(77, 71, 61, 1);
    font-size: 18px;
    line-height: 24px;
    unity-text-align: middle-center;
    white-space: normal;
    flex-shrink: 0;
}

#act-transition-intermission-illustration-frame {
    width: 760px;
    max-width: 760px;
    height: 280px;
    flex-shrink: 0;
    background-color: rgba(207, 198, 181, 1);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(200, 188, 166, 1);
    border-right-color: rgba(200, 188, 166, 1);
    border-top-color: rgba(200, 188, 166, 1);
    border-bottom-color: rgba(200, 188, 166, 1);
    overflow: hidden;
    margin-bottom: 18px;
}

#act-transition-intermission-illustration-inset {
    flex-grow: 1;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    overflow: hidden;
}

#act-transition-intermission-illustration-image {
    width: 100%;
    height: 100%;
}

#act-transition-intermission-illustration-placeholder {
    display: none;
}

#act-transition-intermission-shell .act-transition-divider {
    width: 760px;
    height: 1px;
    flex-shrink: 0;
    margin-bottom: 20px;
    background-color: rgba(210, 199, 181, 1);
}

#act-transition-intermission-resource-summary {
    width: 760px;
    min-height: 116px;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 28px;
}

.act-transition-intermission-resource-column {
    flex-direction: column;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
}

.act-transition-intermission-resource-header {
    color: rgba(141, 116, 80, 1);
    font-size: 14px;
    line-height: 18px;
    -unity-font-style: bold;
    margin-bottom: 10px;
}

.act-transition-intermission-resource-rows {
    flex-direction: column;
    gap: 8px;
}

.act-transition-intermission-resource-row {
    height: 24px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.act-transition-intermission-resource-label {
    color: rgba(53, 49, 41, 1);
    font-size: 16px;
    line-height: 20px;
}

.act-transition-intermission-resource-value {
    color: rgba(36, 33, 27, 1);
    font-size: 18px;
    line-height: 20px;
    -unity-font-style: bold;
}

#act-transition-intermission-resource-divider {
    width: 1px;
    height: 92px;
    margin-left: 24px;
    margin-right: 24px;
    background-color: rgba(207, 195, 175, 1);
    flex-shrink: 0;
}

#act-transition-selection-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    flex-shrink: 0;
}

#act-transition-selection-prompt {
    flex-grow: 1;
    min-width: 0;
    max-width: 880px;
    color: rgba(43, 39, 34, 1);
    font-size: 34px;
    line-height: 38px;
    white-space: normal;
}

#act-transition-selection-resource-panel {
    width: 300px;
    flex-direction: column;
    align-items: flex-end;
    row-gap: 8px;
    flex-shrink: 0;
}

#act-transition-selection-resource-label {
    color: rgba(164, 133, 70, 1);
    font-size: 16px;
    line-height: 20px;
    -unity-font-style: bold;
    unity-text-align: middle-right;
}

#act-transition-selection-resource-strip {
    flex-direction: row;
    justify-content: flex-end;
    column-gap: 16px;
    width: 100%;
}

.act-transition-resource-mini {
    width: auto;
    height: auto;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    gap: 6px;
}

.act-transition-resource-mini-label,
.act-transition-resource-mini-value {
    color: rgba(58, 53, 46, 1);
    font-size: 18px;
    line-height: 22px;
    white-space: nowrap;
}

.act-transition-resource-mini-value {
    -unity-font-style: bold;
}

#act-transition-selection-card-row {
    width: 100%;
    height: 392px;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    margin-top: 28px;
    margin-bottom: 28px;
    flex-shrink: 0;
    overflow: visible;
}

#act-transition-selection-card-group {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    column-gap: 36px;
    flex-shrink: 0;
    overflow: visible;
}

.act-transition-card {
    width: 176px;
    height: 352px;
    margin-left: 60px;
    margin-right: 60px;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0);
    flex-shrink: 0;
    overflow: visible;
    opacity: 0.92;
    scale: 1 1;
    translate: 0 0;
    transition-property: scale, translate, opacity;
    transition-duration: 0.14s;
    transition-timing-function: ease-out;
}

.act-transition-card:focus {
    outline-width: 0;
}

.act-transition-card--hovered {
    opacity: 1;
    scale: 1.06 1.06;
    translate: 0 -10px;
}

.act-transition-card--selected {
    opacity: 1;
}

.act-transition-card--disabled {
    opacity: 0.56;
}

.act-transition-card-art-frame {
    width: 100%;
    height: 100%;
    align-self: center;
    background-color: rgba(221, 212, 196, 0.35);
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(199, 181, 146, 1);
    border-right-color: rgba(199, 181, 146, 1);
    border-top-color: rgba(199, 181, 146, 1);
    border-bottom-color: rgba(199, 181, 146, 1);
    overflow: hidden;
    flex-shrink: 0;
}

.act-transition-card--hovered .act-transition-card-art-frame {
    border-left-color: rgba(168, 137, 75, 0.86);
    border-right-color: rgba(168, 137, 75, 0.86);
    border-top-color: rgba(168, 137, 75, 0.86);
    border-bottom-color: rgba(168, 137, 75, 0.86);
}

.act-transition-card--selected .act-transition-card-art-frame {
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgba(168, 137, 75, 1);
    border-right-color: rgba(168, 137, 75, 1);
    border-top-color: rgba(168, 137, 75, 1);
    border-bottom-color: rgba(168, 137, 75, 1);
}

.act-transition-card-art-inset {
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    overflow: hidden;
}

.act-transition-card-art-image {
    width: 100%;
    height: 100%;
}

#act-transition-selection-detail-panel {
    width: 100%;
    height: 300px;
    padding-left: 22px;
    padding-right: 22px;
    padding-top: 12px;
    padding-bottom: 12px;
    flex-direction: column;
    gap: 0;
    background-color: rgba(238, 230, 218, 1);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(199, 181, 146, 1);
    border-right-color: rgba(199, 181, 146, 1);
    border-top-color: rgba(199, 181, 146, 1);
    border-bottom-color: rgba(199, 181, 146, 1);
    overflow: hidden;
    flex-shrink: 0;
}

#act-transition-selection-detail-title {
    min-height: 34px;
    color: rgba(43, 39, 34, 1);
    font-size: 34px;
    line-height: 34px;
    white-space: nowrap;
    overflow: hidden;
    flex-shrink: 0;
    margin-bottom: 10px;
}

#act-transition-selection-detail-family-row {
    height: 24px;
    flex-direction: row;
    align-items: center;
    column-gap: 10px;
    flex-shrink: 0;
    margin-bottom: 10px;
}

#act-transition-selection-detail-family-badge {
    width: 24px;
    height: 24px;
    align-items: center;
    justify-content: center;
    background-color: rgba(230, 220, 203, 1);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(187, 169, 126, 1);
    border-right-color: rgba(187, 169, 126, 1);
    border-top-color: rgba(187, 169, 126, 1);
    border-bottom-color: rgba(187, 169, 126, 1);
    flex-shrink: 0;
}

#act-transition-selection-detail-family-icon {
    width: 14px;
    height: 14px;
}

#act-transition-selection-detail-family-label {
    color: rgba(63, 58, 52, 1);
    font-size: 18px;
    line-height: 22px;
    white-space: nowrap;
}

#act-transition-selection-detail-effect {
    min-height: 44px;
    color: rgba(63, 58, 52, 1);
    font-size: 20px;
    line-height: 24px;
    white-space: normal;
    overflow: hidden;
    flex-shrink: 0;
    margin-bottom: 10px;
}

#act-transition-selection-detail-glossary {
    flex-grow: 1;
    flex-shrink: 0;
    overflow: hidden;
    background-color: rgba(0, 0, 0, 0);
}

#act-transition-selection-detail-glossary .unity-scroll-view__content-container {
    flex-direction: column;
    row-gap: 8px;
}

.act-transition-glossary-row {
    height: 42px;
    flex-direction: row;
    align-items: center;
    column-gap: 10px;
    padding-left: 14px;
    padding-right: 14px;
    background-color: rgba(232, 224, 210, 1);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(199, 181, 146, 1);
    border-right-color: rgba(199, 181, 146, 1);
    border-top-color: rgba(199, 181, 146, 1);
    border-bottom-color: rgba(199, 181, 146, 1);
    overflow: hidden;
    flex-shrink: 0;
}

.act-transition-glossary-term {
    width: 180px;
    color: rgba(47, 42, 36, 1);
    font-size: 18px;
    line-height: 22px;
    -unity-font-style: bold;
    white-space: nowrap;
    flex-shrink: 0;
}

.act-transition-glossary-text {
    flex-grow: 1;
    color: rgba(90, 83, 73, 1);
    font-size: 18px;
    line-height: 20px;
    max-height: 32px;
    white-space: normal;
    overflow: hidden;
}

.act-transition-actions {
    margin-top: 24px;
    flex-direction: row;
    flex-shrink: 0;
}

#act-transition-intermission-shell .act-transition-actions {
    margin-top: 0;
}

#act-transition-selection-shell .act-transition-actions {
    margin-top: 28px;
    width: 100%;
    justify-content: center;
}

.act-transition-actions--center {
    justify-content: center;
    width: 100%;
}

.act-transition-primary-button {
    width: 170px;
    height: 44px;
    color: rgba(243, 239, 228, 1);
    background-color: rgba(42, 41, 37, 0.98);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(42, 41, 37, 1);
    border-right-color: rgba(42, 41, 37, 1);
    border-top-color: rgba(42, 41, 37, 1);
    border-bottom-color: rgba(42, 41, 37, 1);
    -unity-font-style: bold;
    font-size: 16px;
}

#act-transition-intermission-shell .act-transition-primary-button {
    width: 184px;
    height: 48px;
    color: rgba(244, 240, 232, 1);
    background-color: rgba(36, 33, 27, 1);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    font-size: 20px;
    line-height: 22px;
}

#act-transition-selection-shell .act-transition-primary-button {
    width: 220px;
    height: 60px;
    color: rgba(243, 238, 229, 1);
    background-color: rgba(46, 42, 38, 1);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    font-size: 22px;
    line-height: 24px;
}

.act-transition-primary-button:hover {
    background-color: rgba(59, 58, 52, 1);
}

#act-transition-intermission-shell .act-transition-primary-button:hover {
    background-color: rgba(47, 43, 36, 1);
}

#act-transition-selection-shell .act-transition-primary-button:hover {
    background-color: rgba(59, 54, 48, 1);
}

#act-transition-intermission-shell .act-transition-primary-button:active {
    background-color: rgba(29, 26, 22, 1);
}

#act-transition-selection-shell .act-transition-primary-button:active {
    background-color: rgba(36, 32, 29, 1);
}

.act-transition-primary-button:disabled {
    opacity: 0.56;
}
