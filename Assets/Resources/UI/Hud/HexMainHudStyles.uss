#hud-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

#top-bar {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 76px;
    min-height: 76px;
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 12px;
    padding-bottom: 12px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: rgb(19, 32, 44);
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.08);
}

#top-bar-left {
    width: 220px;
    min-width: 220px;
    max-width: 220px;
    flex-shrink: 1;
    justify-content: center;
}

#run-context-label {
    color: rgb(233, 226, 210);
    font-size: 22px;
    line-height: 24px;
    -unity-font-style: bold;
    white-space: nowrap;
    overflow: hidden;
}

#top-bar-center {
    flex-grow: 1;
    flex-shrink: 1;
    justify-content: center;
    align-items: center;
    padding-left: 24px;
    padding-right: 24px;
    flex-direction: row;
}

#center-status-pocket {
    min-width: 420px;
    max-width: 680px;
    min-height: 52px;
    padding-left: 18px;
    padding-right: 18px;
    padding-top: 4px;
    padding-bottom: 4px;
    flex-direction: column;
    gap: 4px;
    align-items: center;
    justify-content: center;
    overflow: hidden;
}

.status-divider {
    width: 120px;
    height: 1px;
    background-color: rgba(198, 177, 138, 0.45);
    flex-shrink: 0;
}

.status-line {
    color: rgb(243, 239, 230);
    font-size: 26px;
    line-height: 30px;
    -unity-font-style: bold;
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    flex-shrink: 1;
}

#status-meta-row {
    margin-top: 0;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 8px;
    flex-shrink: 0;
}

.travel-chip {
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 2px;
    padding-bottom: 2px;
    background-color: rgba(109, 82, 33, 0.16);
    color: rgb(241, 213, 159);
    font-size: 12px;
    line-height: 14px;
    -unity-font-style: bold;
    border-top-left-radius: 999px;
    border-top-right-radius: 999px;
    border-bottom-left-radius: 999px;
    border-bottom-right-radius: 999px;
    display: none;
}

.hint-copy {
    color: rgba(145, 187, 214, 0.86);
    font-size: 12px;
    line-height: 14px;
    -unity-font-style: italic;
    white-space: normal;
    display: none;
    max-width: 260px;
}

#top-bar-right {
    width: 360px;
    min-width: 360px;
    max-width: 360px;
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
}

#resource-strip {
    flex-direction: row;
    gap: 12px;
    align-items: stretch;
}

.resource-chip {
    width: 104px;
    height: 48px;
    min-width: 104px;
    max-width: 104px;
    min-height: 48px;
    padding-left: 10px;
    padding-right: 12px;
    padding-top: 8px;
    padding-bottom: 8px;
    flex-direction: row;
    align-items: center;
    gap: 10px;
    background-color: rgba(255, 255, 255, 0.04);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.08);
    border-right-color: rgba(255, 255, 255, 0.08);
    border-top-color: rgba(255, 255, 255, 0.08);
    border-bottom-color: rgba(255, 255, 255, 0.08);
}

.resource-icon {
    width: 26px;
    height: 26px;
    margin-right: 0;
    justify-content: center;
    align-items: center;
    background-position-x: center;
    background-position-y: center;
    background-repeat: no-repeat;
    background-size: contain;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.resource-icon-glyph {
    color: rgba(255, 248, 232, 0.96);
    font-size: 13px;
    -unity-font-style: bold;
}

#resource-food-icon {
    background-color: rgba(163, 102, 52, 0.96);
}

#resource-morale-icon {
    background-color: rgba(146, 53, 63, 0.96);
}

#resource-gold-icon {
    background-color: rgba(158, 118, 24, 0.96);
}

.resource-copy {
    flex-direction: column;
    justify-content: center;
    min-width: 0;
}

.resource-name {
    color: rgb(200, 193, 178);
    font-size: 12px;
    line-height: 13px;
    letter-spacing: 0;
    text-transform: uppercase;
    white-space: nowrap;
    overflow: hidden;
}

.resource-value {
    margin-top: 0;
    color: rgb(246, 241, 231);
    font-size: 24px;
    line-height: 24px;
    -unity-font-style: bold;
    white-space: nowrap;
    overflow: hidden;
}

#boon-status {
    position: absolute;
    right: 24px;
    top: 88px;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 2px;
    padding-bottom: 2px;
    color: rgb(241, 213, 159);
    font-size: 9px;
    line-height: 10px;
    background-color: rgba(78, 46, 20, 0.14);
    border-top-left-radius: 999px;
    border-top-right-radius: 999px;
    border-bottom-left-radius: 999px;
    border-bottom-right-radius: 999px;
    display: none;
}

.modal-muted {
    opacity: 0.32;
}

.hud-card {
    position: absolute;
    padding-left: 11px;
    padding-right: 11px;
    padding-top: 9px;
    padding-bottom: 9px;
    background-color: rgba(10, 18, 28, 0.44);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.03);
    border-right-color: rgba(255, 255, 255, 0.03);
    border-top-color: rgba(255, 255, 255, 0.03);
    border-bottom-color: rgba(255, 255, 255, 0.03);
}

#tile-inspector-panel {
    left: 24px;
    bottom: 24px;
    width: 224px;
}

#pitstop-panel {
    right: 24px;
    top: 68px;
    width: 256px;
    display: none;
}

.panel-kicker {
    color: rgba(241, 213, 159, 0.72);
    font-size: 11px;
    line-height: 12px;
    -unity-font-style: bold;
    letter-spacing: 0.6px;
    text-transform: uppercase;
}

.body-copy {
    margin-top: 5px;
    color: rgb(214, 225, 234);
    font-size: 10px;
    line-height: 12px;
    white-space: normal;
}
