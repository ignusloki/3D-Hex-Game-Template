#hud-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

#top-bar {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 48px;
    min-height: 48px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 4px;
    padding-bottom: 4px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: rgba(11, 17, 24, 0.88);
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 2px;
    border-bottom-right-radius: 2px;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.06);
}

#top-bar-left {
    min-width: 90px;
    max-width: 130px;
    flex-shrink: 1;
    justify-content: center;
}

#run-context-label {
    color: rgba(230, 213, 181, 0.64);
    font-size: 10px;
    line-height: 11px;
    -unity-font-style: bold;
    text-transform: uppercase;
    letter-spacing: 0.4px;
    white-space: nowrap;
    overflow: hidden;
}

#top-bar-center {
    flex-grow: 1;
    flex-shrink: 1;
    justify-content: center;
    align-items: center;
    padding-left: 10px;
    padding-right: 10px;
}

#center-status-pocket {
    height: 30px;
    min-width: 180px;
    max-width: 220px;
    min-height: 30px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 3px;
    padding-bottom: 3px;
    background-color: rgba(20, 30, 40, 0.74);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.03);
    border-right-color: rgba(255, 255, 255, 0.03);
    border-top-color: rgba(255, 255, 255, 0.03);
    border-bottom-color: rgba(255, 255, 255, 0.03);
    flex-direction: row;
    gap: 6px;
    align-items: center;
    justify-content: center;
    overflow: hidden;
}

.status-line {
    color: rgba(240, 235, 221, 0.92);
    font-size: 13px;
    line-height: 14px;
    -unity-font-style: bold;
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    flex-shrink: 1;
}

#status-meta-row {
    margin-top: 0;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 4px;
    flex-shrink: 0;
}

.travel-chip {
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 2px;
    padding-bottom: 2px;
    background-color: rgba(109, 82, 33, 0.16);
    color: rgb(241, 213, 159);
    font-size: 9px;
    line-height: 10px;
    -unity-font-style: bold;
    border-top-left-radius: 999px;
    border-top-right-radius: 999px;
    border-bottom-left-radius: 999px;
    border-bottom-right-radius: 999px;
    display: none;
}

.hint-copy {
    color: rgba(145, 187, 214, 0.86);
    font-size: 9px;
    line-height: 10px;
    -unity-font-style: italic;
    white-space: normal;
    display: none;
    max-width: 150px;
}

#top-bar-right {
    min-width: 280px;
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
}

#resource-strip {
    flex-direction: row;
    gap: 4px;
    align-items: stretch;
}

.resource-chip {
    height: 32px;
    min-width: 90px;
    max-width: 92px;
    min-height: 32px;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 3px;
    padding-bottom: 3px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(24, 35, 48, 0.9);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.03);
    border-right-color: rgba(255, 255, 255, 0.03);
    border-top-color: rgba(255, 255, 255, 0.03);
    border-bottom-color: rgba(255, 255, 255, 0.03);
}

.resource-icon {
    width: 20px;
    height: 20px;
    margin-right: 6px;
    justify-content: center;
    align-items: center;
    background-position-x: center;
    background-position-y: center;
    background-repeat: no-repeat;
    background-size: contain;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.resource-icon-glyph {
    color: rgba(255, 248, 232, 0.96);
    font-size: 10px;
    -unity-font-style: bold;
}

#resource-food-icon {
    background-color: rgba(163, 102, 52, 0.96);
}

#resource-morale-icon {
    background-color: rgba(146, 53, 63, 0.96);
}

#resource-gold-icon {
    background-color: rgba(158, 118, 24, 0.96);
}

.resource-copy {
    flex-direction: column;
    justify-content: center;
    min-width: 0;
}

.resource-name {
    color: rgba(201, 212, 224, 0.68);
    font-size: 9px;
    line-height: 9px;
    letter-spacing: 0;
    text-transform: uppercase;
    white-space: nowrap;
    overflow: hidden;
}

.resource-value {
    margin-top: 0;
    color: rgb(248, 241, 219);
    font-size: 15px;
    line-height: 14px;
    -unity-font-style: bold;
    white-space: nowrap;
    overflow: hidden;
}

#boon-status {
    position: absolute;
    right: 24px;
    top: 56px;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 2px;
    padding-bottom: 2px;
    color: rgb(241, 213, 159);
    font-size: 9px;
    line-height: 10px;
    background-color: rgba(78, 46, 20, 0.14);
    border-top-left-radius: 999px;
    border-top-right-radius: 999px;
    border-bottom-left-radius: 999px;
    border-bottom-right-radius: 999px;
    display: none;
}

.hud-card {
    position: absolute;
    padding-left: 11px;
    padding-right: 11px;
    padding-top: 9px;
    padding-bottom: 9px;
    background-color: rgba(10, 18, 28, 0.44);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.03);
    border-right-color: rgba(255, 255, 255, 0.03);
    border-top-color: rgba(255, 255, 255, 0.03);
    border-bottom-color: rgba(255, 255, 255, 0.03);
}

#tile-inspector-panel {
    left: 24px;
    bottom: 24px;
    width: 224px;
}

#pitstop-panel {
    right: 24px;
    top: 68px;
    width: 256px;
    display: none;
}

.panel-kicker {
    color: rgba(241, 213, 159, 0.72);
    font-size: 11px;
    line-height: 12px;
    -unity-font-style: bold;
    letter-spacing: 0.6px;
    text-transform: uppercase;
}

.body-copy {
    margin-top: 5px;
    color: rgb(214, 225, 234);
    font-size: 10px;
    line-height: 12px;
    white-space: normal;
}
